    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.21.0",
    "element-plus": "2.14.8",
    "js-cookie": "3.0.8",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "path-to-regexp": "9.0.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "mockjs": "1.1.0",
    "sass": "1.108.1",
    "vite": "8.3.6",
    "vite-plugin-svg-icons": "2.0.1",
    "vitest": "^5.1.0",
