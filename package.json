  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.0",
    "eslint-plugin-vue": "10.10.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "mockjs": "1.1.0",
